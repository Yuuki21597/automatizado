{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\u256d\u2500\ue0b2",
          "template": "{{ if eq (.UserName) (\"WindowsUserName\") }} PreferredUserName {{ else if eq (.UserName) (\"$USER\") }} PreferredUserName {{ else if eq (.UserName) (\"root\") }} Superusuario {{ else }} {{ .UserName }} {{ end }}",
          "powerline_symbol": "\ue0b0",
          "foreground": "#0087AF",
          "background": "#F2F3F8",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "cache_duration": "none",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "powerline_symbol": "\ue0b0",
          "template": " {{ .Icon }}  ",
          "foreground": "#FFFFFF",
          "background": "#5865f2",
          "type": "os",
          "style": "powerline"
        },
        {
          "template": "{{ .Env.NOMBRE_EQUIPO }} ",
          "foreground": "#FFFFFF",
          "background": "#5865f2",
          "type": "text",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "powerline_symbol": "\ue0b0",
          "template": " {{ if .Env.VIRTUAL_ENV_PROMPT }}{{ .Env.VIRTUAL_ENV_PROMPT }}{{ else }}\ueab8{{ end }}  ",
          "foreground": "#000000",
          "background": "#FDFBD4",
          "type": "text",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "mapped_locations": {
              "~": "C:\\Users\\House"
            },
            "mapped_locations_enabled": true,
            "style": "full"
          },
          "powerline_symbol": "\ue0b0",
          "foreground": "#f2f3f8",
          "background": "#366959",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_gone_icon": "\ueab8",
            "branch_icon": "\uf418 ",
            "branch_identical_icon": "\uf444",
            "branch_max_length": 25,
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true
          },
          "trailing_diamond": "\ue0b0",
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <transparent>\ue0b1</> <#121318>\uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <transparent>\ue0b1</> <#121318>\uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <transparent>\ue0b1</> <#121318>\ueb4b {{ .StashCount }}</>{{ end }} ",
          "background": "#e4e4e4",
          "type": "git",
          "style": "diamond",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#a97400{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#54433a{{ end }}",
            "{{ if gt .Ahead 0 }}#744d89{{ end }}",
            "{{ if gt .Behind 0 }}#744d89{{ end }}"
          ]
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\u2570\u2500 \uf0a4 ",
          "foreground": "#F2F3F8",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
