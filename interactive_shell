#
# ~/bashrc
#

# No hacer nada si no es una consola interactiva.
[[ $- != *i* ]] && return

if command -v oh-my-posh > /dev/null; then
	eval "$(oh-my-posh init bash --config "$HOME/.config/oh-my-posh/$USER.omp.json")"
else
	PS1='[\u@\h \W]\$ '
fi

export HISTCONTROL=ignoreboth:erasedups
export NOMBRE_EQUIPO=$(lsblk -Po MOUNTPOINT,LABEL | grep '"/"' | awk -F '"' '{print $4}')
export REPO="$HOME/Documentos/Repositorio"
export AUTO="$REPO/automatizado"
export SM="$AUTO/script_maestro.sh"

control_de_filtro() {
    $SM consola filtro "$2" "$1"
}

qtile() {
	local DEV_QTILE="$REPO/entornos/qtile-env/bin/qtile"

	if [ "$ENTORNO" == 'qtile-dev' ] && [ -f "$DEV_QTILE" ]; then
		"$DEV_QTILE" "$@"
	else
		command qtile "$@"
	fi
}

# Sistema.
alias reiniciar='systemctl reboot'
alias apagar='systemctl poweroff'
alias actualizar='yay -Syu'

# Comandos generales para la terminal.
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Atajos de y hacia directorios.
alias home='cd $HOME'
alias {repo,repositorio}='cd $REPO'

# Atajos para comandos del script maestro.
alias sm='$SM'
alias iniciar='$SM inicio'
alias limpiar-actualización='$SM consola limpiar-actualización'
alias reiniciar-audio='$SM consola reiniciar-audio'
alias crear-swap='$SM consola crear-swap'
alias borrar-swap='$SM consola borrar-swap'
alias genshin='$SM consola historial-de-tiradas-de-genshin'
alias filtro='$SM consola filtro'
alias probar='control_de_filtro Probando...'
alias compilar-mpv='$SM codigo-fuente mpv'

# Montaje de unidades.
alias montar='$SM unidades montar'
alias {expulsar,desmontar}='$SM unidades desmontar'
alias montar-todo='$SM unidades montaje_de_unidades'
alias {expulsar-todo,desmontar-todo}='$SM unidades desmontaje_de_unidades'
